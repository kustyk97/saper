<Window x:Class="Saper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Saper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="ziarno">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Ustawienia_gry">
                    <MenuItem Header="Poziom Trudności">
                        <MenuItem Header="Łatwy" Click="click_latwy"/>
                        <MenuItem Header="Średni"   Click="click_sredni"/>
                        <MenuItem Header="Trudny" Click="click_trudny"/>
                        <MenuItem Header="Własny" Click="click_wlasny"/>
                    </MenuItem>
                    <MenuItem Header="Od autora" Click="click_od_autora"/>
                </MenuItem>
                    <MenuItem Header="Restart" Click="click_restart"/>
            </Menu>
            <Grid x:Name="siatka" Margin="0,0,0,0">
                
            </Grid>
        </DockPanel>
        
    </Grid>
</Window>
