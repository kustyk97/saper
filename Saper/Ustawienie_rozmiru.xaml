<Window x:Class="Saper.ustawienie_rozmiru"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Saper"
        mc:Ignorable="d"
        Title="Ustawienia" Height="300" Width="200" MinWidth="200" MinHeight="300" MaxWidth="200" MaxHeight="300">
    <Grid>
        <Button x:Name="Zastosuj" Content="Zastosuj" HorizontalAlignment="Left" Margin="10,239,0,0" VerticalAlignment="Top" Width="75" Click="Zastosuj_Click"/>
        <Button x:Name="Cancel" Content="Anuluj" HorizontalAlignment="Left" Margin="107,239,0,0" VerticalAlignment="Top" Width="75" Click="Cancel_Click"/>
        
        <Label x:Name="label_x" Content="Ilość kolumn:" HorizontalAlignment="Left" Margin="10,28,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <TextBox x:Name="textBox_x" HorizontalAlignment="Left" Height="26" Margin="94,28,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="79" RenderTransformOrigin="-1.054,0.411" VerticalContentAlignment="Center"/>
        
        <Label x:Name="label_y" Content="Ilość wierszy:" HorizontalAlignment="Left" Margin="10,74,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_y" HorizontalAlignment="Left" Height="26" Margin="94,74,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="79" RenderTransformOrigin="-1.054,0.411" VerticalContentAlignment="Center"/>

        <Label x:Name="label_bombs" Content="Ilość Bomb" HorizontalAlignment="Left" Margin="10,132,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_bombs" HorizontalAlignment="Left" Height="26" Margin="94,132,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="79" RenderTransformOrigin="-1.054,0.411" VerticalContentAlignment="Center"/>

    </Grid>
</Window>
